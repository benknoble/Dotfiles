#! /usr/bin/env bash

set -euo pipefail

USAGE='[-hm] [-- <rev-list args>]

Display blobs and sizes. Machine-readable with -m.
git-rev-list(1) arguments default to --all, but providing
any arguments at all disables that automatic default.'
SUBDIRECTORY_OK=true

# source git-sh-setup for some helpers
set +u
source "$(git --exec-path)"/git-sh-setup
set -u

log() {
  printf '%s\n' "$@"
} >&2

main() {
  filter=(cut -c 1-12,41-)
  format=(
    $(command -v gnumfmt || echo numfmt)
    --field=2 --to=iec-i --suffix=B --padding=7 --round=nearest
  )

  while getopts 'm-' opt ; do
    case "$opt" in
      m) filter=(cat); format=(cat) ;;
      -) break ;;
      ?) usage ;;
    esac
  done

  shift $((OPTIND - 1))

  if (( $# == 0 )); then
    set -- --all
  else
    case "$*" in
      (*--objects-*) die "incompatible option: --objects-* in $*" ;;
    esac
  fi

  git rev-list --objects "$@" |
    git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' |
    sed -n 's/^blob //p' |
    sort --reverse --numeric-sort --key=2 |
    "${filter[@]}" | "${format[@]}"
}

main "$@"
