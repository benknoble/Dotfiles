#! /usr/bin/env bash
# display weekly statistics about a git repo

set -euo pipefail

dir="$( cd "$( dirname "${BASH_SOURCE[0]}")" && pwd )"

# set up some common variables
USAGE='[-h]
Display a weekly summary of repo'
SUBDIRECTORY_OK=true

# source git-sh-setup for some helpers
set +u
source "$(git --exec-path)"/git-sh-setup
set -u

weekly_git_log() {
  git log --color=never --since=1.week --oneline
}

weekly_git_stats() {
  weekly_git_log | tail -n 1 | awk '{ print $1 }' | xargs git diff --shortstat
}

features_merged() {
  weekly_git_log | { grep -E "Merge (pull|branch) " || true; }

}

count_features() {
  sed '/^\s*$/d' | wc -l | awk '{ print $1 }'
}

display_weekly_stats() {
  printf '%s\n' "Stats (Last week - Today)"
  printf '%s\n' "---------------------"
  printf '%s\n' "${1:-No stats available}"
  printf '\n'
  printf '%s\n' "Features ($2)"
  printf '%s\n' "-------------"
  printf '%s\n' "$3"
}

weekly() {
  local stats features features_count
  stats="$(weekly_git_stats)"
  features="$(features_merged)"
  features_count="$(features_merged | count_features)"
  display_weekly_stats "$stats" "$features_count" "$features"
}

if [[ $# -gt 0 ]]; then
  usage
else
  weekly
fi
